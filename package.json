{
  "name": "rshbins-legacy-foundations",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./legacy/*": "./legacy/*"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/generate-legacy-icons.mjs"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.2.8",
    "classnames": "^2.5.1",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/react": "^17.0.90",
    "@types/react-dom": "^17.0.26",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
